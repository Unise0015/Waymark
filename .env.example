# Database
DATABASE_URL=postgresql+asyncpg://waymark:waymark_dev_secret@localhost:5432/waymark
DATABASE_URL_SYNC=postgresql+psycopg2://waymark:waymark_dev_secret@localhost:5432/waymark

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=waymark-dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
DEBUG=true
APP_NAME=Waymark
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Tool paths (override if not in system PATH)
# SUBFINDER_PATH=/usr/local/bin/subfinder
# NUCLEI_PATH=/usr/local/bin/nuclei
# FFUF_PATH=/usr/local/bin/ffuf

# AI / LLM Configuration
# Choose ONE primary provider to use for the Agent Decision Trail and Reporting
# --------------------------------------------------------------------------
# Google Gemini (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Ollama (Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1


